APP_NAME=DRIFT
APP_ENV=development
DEBUG=true

# SQLite database path
DATABASE_URL=sqlite+aiosqlite:///./data/news.db

# Groq LLM
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama3-8b-8192

# Search Provider & SerpAPI
SEARCH_PROVIDER=serpapi
SEARCH_ENGINE=duckduckgo
SERPAPI_API_KEY=

# Timeouts (seconds)
REQUEST_TIMEOUT_SECONDS=15
LLM_TIMEOUT_SECONDS=60

# Content limits
MAX_ARTICLE_BYTES=5000000
MAX_ARTICLE_CHARS=100000

# Concurrency limits
MAX_CONCURRENT_FETCHES=8
MAX_CONCURRENT_LLM_CALLS=4

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Embeddings
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=cpu

# Logging
LOG_LEVEL=INFO

# Pipeline versions (increment when prompts change)
PIPELINE_VERSION=1.0
CLAIM_EXTRACTOR_VERSION=1
DRIFT_ENGINE_VERSION=1
REPORT_VERSION=1

# Optional: free-tier news API keys
GNEWS_API_KEY=
NEWSDATA_API_KEY=

# Retrieval scoring weights (must sum to 1.0)
SCORE_WEIGHT_EMBEDDING=0.30
SCORE_WEIGHT_LEXICAL=0.20
SCORE_WEIGHT_ENTITY=0.20
SCORE_WEIGHT_TEMPORAL=0.15
SCORE_WEIGHT_LOCATION=0.10
SCORE_WEIGHT_SOURCE=0.05
